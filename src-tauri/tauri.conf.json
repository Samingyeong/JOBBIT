{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JOBBIT",
  "version": "0.1.0",
  "identifier": "app.jobbit.desktop",
  "build": {
    "beforeDevCommand": "npm run web",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../web"
  },
  "app": {
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src 'self'" },
    "windows": [{"label":"main","title":"JOBBIT","width":550,"height":830,"minWidth":440,"minHeight":600,"center":true,"resizable":true,"decorations":true,"alwaysOnTop":false}]
  },
  "bundle": {"active":true,"targets":"all"}
}
